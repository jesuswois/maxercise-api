// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums

enum Role {
  NORMAL
  SUPER
}

enum Difficulty {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum Body {
  ECTOMORFO
  MESOMORFO
  ENDOMORFO
}

model User {
  id Int @id @default(autoincrement())
  first_name String
  last_name String
  email String @unique
  phone_number String
  password String
  createdAt DateTime @default(now())
  role Role
  exercises Exercise[]
  routines Routine[]
  muscles Muscle[]
  muscle_groups MuscleGroups[]
}

model Exercise {
  id Int @id @default(autoincrement())
  title String
  description String
  instructions String
  createdAt DateTime @default(now())
  author_id Int
  author User @relation(fields: [author_id],references: [id])
  imageUrl String
  routines RoutineExercise[]
}

model Routine {
  id Int @id @default(autoincrement())
  title String
  description String?
  difficulty Difficulty
  body_type Body
  author_id Int
  author User @relation(fields:[author_id],references: [id])
  exercises RoutineExercise[]
}

model RoutineExercise{
  id Int @id @default(autoincrement())
  reps Int
  sets Int
  routine_id Int
  routine Routine @relation(fields: [routine_id],references: [id])
  exercise_id Int
  exercise Exercise @relation(fields:[exercise_id],references: [id])
}

model Muscle {
  id Int @id @default(autoincrement())
  name String @unique
  description String @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  muscle_group_id Int
  muscle_group MuscleGroups? @relation(fields: [muscle_group_id],references: [id])
  author_id Int
  author User @relation(fields: [author_id],references: [id])
}


model MuscleGroups {
  id Int @id @default(autoincrement())
  name String @unique
  description String @unique
  Muscles Muscle[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  author_id Int
  author User @relation(fields: [author_id],references: [id])
}

model Restriction {
  id Int @id @default(autoincrement())
  name String @unique
  description String @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  author_id Int
  author User @relation(fields: [author_id],references: [id])
}