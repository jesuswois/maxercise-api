// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums

enum Role {
  NORMAL
  SUPER
}

enum Difficulty {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum Body {
  ECTOMORFO
  MESOMORFO
  ENDOMORFO
}

enum Severity {
  WARNING
  BLOCK
}

model User {
  id Int @id @default(autoincrement())
  first_name String
  last_name String
  email String @unique
  phone_number String
  password String
  role Role
  routine_exercises RoutineExercise[]
  exercises Exercise[]
  routines Routine[]
  muscles Muscle[]
  muscle_groups MuscleGroups[]
  restrictions Restriction[]
  user_restrictions UserRestrictions[]
  exercise_restrictions ExerciseRestrictions[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status Boolean @default(true)
}

model Exercise {
  id Int @id @default(autoincrement())
  title String
  description String
  instructions String
  author_id Int
  author User @relation(fields: [author_id],references: [id])
  imageUrl String
  exercise_restrictions ExerciseRestrictions[]
  routines RoutineExercise[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status Boolean @default(true)
}

model Routine {
  id Int @id @default(autoincrement())
  title String
  description String?
  difficulty Difficulty
  body_type Body
  author_id Int
  author User @relation(fields:[author_id],references: [id])
  exercises RoutineExercise[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status Boolean @default(true)
}

model RoutineExercise{
  id Int @id @default(autoincrement())
  reps Int
  sets Int
  routine_id Int
  routine Routine @relation(fields: [routine_id],references: [id])
  exercise_id Int
  exercise Exercise @relation(fields:[exercise_id],references: [id])
  author_id Int
  author User @relation(fields: [author_id],references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status Boolean @default(true)
}

model Muscle {
  id Int @id @default(autoincrement())
  name String @unique
  description String @unique
  muscle_group_id Int
  muscle_group MuscleGroups? @relation(fields: [muscle_group_id],references: [id])
  author_id Int
  author User @relation(fields: [author_id],references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status Boolean @default(true)
}


model MuscleGroups {
  id Int @id @default(autoincrement())
  name String @unique
  description String @unique
  Muscles Muscle[]
  author_id Int
  author User @relation(fields: [author_id],references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status Boolean @default(true)
}

model Restriction {
  id Int @id @default(autoincrement())
  name String @unique
  description String @unique
  author_id Int
  author User @relation(fields: [author_id],references: [id])
  user_restrictions UserRestrictions[]
  exercise_restrictions ExerciseRestrictions[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status Boolean @default(true)
}

model ExerciseRestrictions {
  id Int @id @default(autoincrement())
  severity Severity
  exercise_id Int
  exercise Exercise @relation(fields: [exercise_id],references: [id])
  restriction_id Int
  restriction Restriction @relation(fields: [restriction_id],references: [id])
  author_id Int
  author User @relation(fields: [author_id],references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status Boolean @default(true)
}

model UserRestrictions {
  id Int @id @default(autoincrement())
  user_id Int
  user User @relation(fields: [user_id],references: [id])
  restriction_id Int
  restriction Restriction @relation(fields: [restriction_id],references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status Boolean @default(true)
}